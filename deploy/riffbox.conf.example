# /etc/riffbox.conf   (owner root, group _riffbox, mode 640)
RIFFBOX_DATA_DIR=/var/riffbox
# The app is served at https://sanjaysubramanian.com/ideas/
RIFFBOX_BASE_PATH=/ideas
RIFFBOX_STATIC_DIR=/usr/local/riffbox/static
# Long random strings. Generate each with:  openssl rand -hex 32
RIFFBOX_SECRET=CHANGE-ME
RIFFBOX_UPLOAD_TOKEN=CHANGE-ME
# What you type to log in to the web UI:
RIFFBOX_PASSPHRASE=CHANGE-ME
# Optional (phase 3.5): lets the server make FLAC play copies of Apple Lossless memos.
# RIFFBOX_FFMPEG=/usr/local/bin/ffmpeg
# Optional (phase 8): the folder the "Backup and export" page's "Back up now" button writes to.
# Create it first:  doas install -d -o _riffbox -g _riffbox -m 700 /var/riffbox-backup
# RIFFBOX_BACKUP_DIR=/var/riffbox-backup
