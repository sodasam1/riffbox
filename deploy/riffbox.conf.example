# /etc/riffbox.conf   (owner root, group _riffbox, mode 640)
RIFFBOX_DATA_DIR=/mnt/data/apps/riffbox/data
# The app is served at https://sanjaysubramanian.com/ideas/
RIFFBOX_BASE_PATH=/ideas
RIFFBOX_STATIC_DIR=/usr/local/riffbox/static
# Long random strings. Generate each with:  openssl rand -hex 32
RIFFBOX_SECRET=CHANGE-ME
RIFFBOX_UPLOAD_TOKEN=CHANGE-ME
# What you type to log in to the web UI:
# A salted hash of the login passphrase, never the passphrase itself. deploy/install.sh writes this for you; by hand:
#   printf '%s\n' 'your long passphrase' | python3 /usr/local/riffbox/deploy/hash_passphrase.py
RIFFBOX_PASSPHRASE_HASH=CHANGE-ME
# Optional: how strict the wrong-passphrase limit is (defaults: 5 wrong tries per client within 15 minutes, then that client waits).
# A whole number each; a typo stops the app at start-up. Example for a relaxed limit: 15 tries per 5 minutes.
# RIFFBOX_LOGIN_MAX_FAILS=15
# RIFFBOX_LOGIN_WINDOW_MINUTES=5
# Optional (phase 3.5): lets the server make FLAC play copies of Apple Lossless memos.
# RIFFBOX_FFMPEG=/usr/local/bin/ffmpeg
# Optional (phase 8): the folder the "Backup and export" page's "Back up now" button writes to.
# Create it first:  doas install -d -o _riffbox -g _riffbox -m 700 /mnt/data/apps/riffbox/backup
# RIFFBOX_BACKUP_DIR=/mnt/data/apps/riffbox/backup
